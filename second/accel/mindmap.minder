            <node id="58" posx="1176.5" posy="2433" width="185" height="66" side="right" fold="false" treesize="2569" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="squared" nodewidth="200" nodeborderwidth="6" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="**Interconnection systems**"/>
              </nodename>
              <nodenote></nodenote>
              <nodes>
                <node id="66" posx="1461.5" posy="1181.5" width="204" height="104" side="right" fold="false" treesize="104" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="At design time an abstraction to simplify the reuse and integration"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
                <node id="67" posx="1461.5" posy="1285.5" width="223" height="161" side="right" fold="false" treesize="161" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="At runtime a communication medium for energy efficient exchange of massive amounts of data and a distributed mechanism to manage resources"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
                <node id="115" posx="1461.5" posy="1446.5" width="197" height="66" side="right" fold="false" treesize="66" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="**Up to 50% of the SoC's power**"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
                <node id="219" posx="1461.5" posy="2433" width="188" height="47" side="right" fold="false" treesize="1888" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="Is mainly of 2 types:"/>
                  </nodename>
                  <nodenote></nodenote>
                  <nodes>
                    <node id="220" posx="1749.5" posy="1569" width="207" height="123" side="right" fold="false" treesize="236" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="**Shared address**: there is a physical memory resource that multiple components access"/>
                      </nodename>
                      <nodenote></nodenote>
                      <nodes>
                        <node id="221" posx="2056.5" posy="1512.5" width="200" height="66" side="right" fold="false" treesize="66" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                          <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                          <nodename maxwidth="200">
                            <text data="Requires coordination and synchronization"/>
                          </nodename>
                          <nodenote></nodenote>
                        </node>
                        <node id="223" posx="2056.5" posy="1578.5" width="218" height="85" side="right" fold="false" treesize="85" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                          <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                          <nodename maxwidth="200">
                            <text data="**UMA**: access times does not depend on the processor"/>
                          </nodename>
                          <nodenote></nodenote>
                          <nodes>
                            <node id="226" posx="2374.5" posy="1588" width="198" height="66" side="right" fold="false" treesize="66" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                              <nodename maxwidth="200">
                                <text data="Less scalable and difficult to implement"/>
                              </nodename>
                              <nodenote></nodenote>
                            </node>
                          </nodes>
                        </node>
                        <node id="224" posx="2056.5" posy="1663.5" width="219" height="85" side="right" fold="false" treesize="85" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                          <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                          <nodename maxwidth="200">
                            <text data="**NUMA**: access time varies between processors"/>
                          </nodename>
                          <nodenote></nodenote>
                          <nodes>
                            <node id="225" posx="2375.5" posy="1673" width="221" height="66" side="right" fold="false" treesize="66" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
