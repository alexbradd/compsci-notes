                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="**Determines the width, control strategy, arbiter and protocol**"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
                <node id="248" posx="396.33333333332848" posy="-1698.7083333333339" width="180" height="47" side="right" fold="false" treesize="227" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="Main protocols are:"/>
                  </nodename>
                  <nodenote></nodenote>
                  <nodes>
                    <node id="249" posx="676.33333333332848" posy="-1788.7083333333339" width="225" height="123" side="right" fold="false" treesize="123" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="Strobe: master makes a req on the req line and the transfer is considered finished after a fixed interval"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                    <node id="250" posx="676.33333333332848" posy="-1665.7083333333339" width="214" height="104" side="right" fold="false" treesize="104" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="Handshake: like strobe, but the slaves signals the end of the transfer intead"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                  </nodes>
                </node>
              </nodes>
            </node>
            <node id="243" posx="113.33333333332848" posy="-1509.7083333333339" width="142" height="66" side="right" fold="false" treesize="170" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="squared" nodewidth="200" nodeborderwidth="6" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="**Interface generation**"/>
              </nodename>
              <nodenote></nodenote>
              <nodes>
                <node id="246" posx="355.33333333332848" posy="-1561.7083333333339" width="215" height="104" side="right" fold="false" treesize="104" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
