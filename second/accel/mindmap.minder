                <node id="294" posx="-6482.3095238095266" posy="-6243.2321428571413" width="211" height="85" side="top" fold="false" treesize="211" color="#68b723" colorroot="false" summarized="false" layout="Upwards" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="HLS is now **push-button, but we have to it the right way**"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
                <node id="295" posx="-6163.3095238095266" posy="-6262.2321428571413" width="225" height="104" side="top" fold="false" treesize="441" color="#68b723" colorroot="false" summarized="false" layout="Upwards" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="HLS can deal with very complex designs, but we have to **deal with resources**"/>
                  </nodename>
                  <nodenote></nodenote>
                  <nodes>
                    <node id="296" posx="-6271.3095238095266" posy="-6447.2321428571413" width="218" height="85" side="top" fold="false" treesize="218" color="#68b723" colorroot="false" summarized="false" layout="Upwards" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="Resources sharing must be used in the correct amount"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                    <node id="297" posx="-6053.3095238095266" posy="-6466.2321428571413" width="223" height="104" side="top" fold="false" treesize="223" color="#68b723" colorroot="false" summarized="false" layout="Upwards" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="Interconnection must be generated such that it does not violate constraints"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                  </nodes>
                </node>
                <node id="298" posx="-5309.8095238095266" posy="-6300.2321428571413" width="213" height="142" side="top" fold="false" treesize="1254" color="#68b723" colorroot="false" summarized="false" layout="Upwards" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="The **designer explores the design space** by placing constraints and looking at the automatically-generated designs."/>
                  </nodename>
                  <nodenote></nodenote>
                  <nodes>
                    <node id="308" posx="-5830.3095238095266" posy="-6504.2321428571413" width="185" height="104" side="top" fold="false" treesize="185" color="#68b723" colorroot="false" summarized="false" layout="Upwards" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="**Coarse-grain**: simply limiting the number of some hardware resources"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                    <node id="309" posx="-5645.3095238095266" posy="-6542.2321428571413" width="215" height="142" side="top" fold="false" treesize="215" color="#68b723" colorroot="false" summarized="false" layout="Upwards" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="**Fine-grain**: fine tuning the scheduling/binding, and automatically&#10;evaluate the thousands of resulting solutions"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                    <node id="313" posx="-5430.3095238095266" posy="-6504.2321428571413" width="213" height="104" side="top" fold="false" treesize="213" color="#68b723" colorroot="false" summarized="false" layout="Upwards" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="Can be done also using **genetic algorithms** to improve the solutions"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                    <node id="310" posx="-5217.3095238095266" posy="-6504.2321428571413" width="205" height="104" side="top" fold="false" treesize="205" color="#68b723" colorroot="false" summarized="false" layout="Upwards" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="Always **happens at the RLT level** since logic synthesis is too slow"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                    <node id="311" posx="-5012.3095238095266" posy="-6542.2321428571413" width="214" height="142" side="top" fold="false" treesize="214" color="#68b723" colorroot="false" summarized="false" layout="Upwards" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="Even with coarse-grain methods, the **design exploration can only be done a small portion** of the specification"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                    <node id="314" posx="-4798.3095238095266" posy="-6504.2321428571413" width="222" height="104" side="top" fold="false" treesize="222" color="#68b723" colorroot="false" summarized="false" layout="Upwards" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="The **compiler** must always **ensure that the generated design is correct**"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                  </nodes>
                </node>
              </nodes>
            </node>
            <node id="289" posx="-4576.3095238095266" posy="-6075.2321428571413" width="199" height="104" side="top" fold="false" treesize="436" color="#68b723" colorroot="false" summarized="false" layout="Upwards" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="**Medium term**: tools for improving design productivity at system-level"/>
              </nodename>
              <nodenote></nodenote>
              <callout>
                <text maxwidth="200">
                  <text data="Non so bene se Cassano l'abbia fatta a lezione, visto che non ho memoria di questa parte e non ho appunti"/>
                </text>
                <style calloutfont="Sans 12" calloutpadding="5" calloutptrwidth="20" calloutptrlength="20"/>
              </callout>
            </node>
            <node id="290" posx="-4140.3095238095266" posy="-6077.2321428571413" width="212" height="123" side="top" fold="false" treesize="449" color="#68b723" colorroot="false" summarized="false" layout="Upwards" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="**Long term**: automatic porting of legacy designs on parallel/heterogeneous systems"/>
              </nodename>
              <nodenote></nodenote>
              <callout>
                <text maxwidth="200">
                  <text data="Non so bene se Cassano l'abbia fatta a lezione, visto che non ho memoria di questa parte e non ho appunti"/>
                </text>
                <style calloutfont="Sans 12" calloutpadding="5" calloutptrwidth="20" calloutptrlength="20"/>
              </callout>
            </node>
          </nodes>
        </node>
        <node id="292" posx="-3691.3095238095266" posy="-5816.2321428571413" width="216" height="66" side="top" fold="false" treesize="216" color="#3689e6" colorroot="false" summarized="false" layout="Upwards" group="false">
          <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
          <nodename maxwidth="200">
            <text data="Support from CAD tools is required"/>
          </nodename>
          <nodenote></nodenote>
        </node>
      </nodes>
    </node>
