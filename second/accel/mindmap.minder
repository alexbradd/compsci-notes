                  <nodenote></nodenote>
                  <nodes>
                    <node id="29" posx="1756.5" posy="-36.5" width="211" height="123" side="right" fold="false" treesize="123" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="Limited in size and execution time since it must not interfere with the rest of the CPU pipeline"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                    <node id="31" posx="1756.5" posy="86.5" width="215" height="104" side="right" fold="false" treesize="104" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="Ideal for small, simple and frequently operations (e.g. crypto/hashing primitives)"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                  </nodes>
                </node>
                <node id="30" posx="1449.5" posy="492.5" width="211" height="104" side="right" fold="false" treesize="708" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="**Loosely-coupled**: found outside the CPU, controlled by the OS's drivers"/>
                  </nodename>
                  <nodenote></nodenote>
                  <nodes>
                    <node id="32" posx="1760.5" posy="190.5" width="211" height="66" side="right" fold="false" treesize="66" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="can be any and run for as long as they want"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                    <node id="436" posx="1760.5" posy="256.5" width="213" height="66" side="right" fold="false" treesize="66" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="can handle much more data than TCA"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                    <node id="34" posx="1760.5" posy="516" width="226" height="123" side="right" fold="false" treesize="510" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="**Data needs to be transferred** back and forth (copied by the CPU in scratchpad memories or by **DMA**)"/>
                      </nodename>
                      <nodenote></nodenote>
                      <nodes>
                        <node id="111" posx="2086.5" posy="355.5" width="222" height="123" side="right" fold="false" treesize="189" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                          <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                          <nodename maxwidth="200">
                            <text data="**Special attention** needs to be given to the **balance between communication and computation**"/>
                          </nodename>
                          <nodenote></nodenote>
                          <nodes>
                            <node id="112" posx="2408.5" posy="322.5" width="217" height="85" side="right" fold="false" treesize="85" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
