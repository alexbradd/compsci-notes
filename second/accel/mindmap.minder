                      <nodenote></nodenote>
                      <nodes>
                        <node id="227" posx="2070.5" posy="1748.5" width="219" height="85" side="right" fold="false" treesize="85" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
