                </node>
                <node id="247" posx="417.33333333332848" posy="-2053.7083333333339" width="223" height="161" side="right" fold="false" treesize="161" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="Many **different channels that are not used concurrently** can be grouped and **multiplexed together onto the same physical one**"/>
                  </nodename>
