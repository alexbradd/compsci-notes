                          <nodenote></nodenote>
                        </node>
                      </nodes>
                    </node>
                    <node id="109" posx="1744.5" posy="1049.5" width="199" height="85" side="right" fold="false" treesize="85" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="**Parallel**: All units are active and run in parallel"/>
