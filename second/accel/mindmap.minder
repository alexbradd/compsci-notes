                  <nodes>
                    <node id="86" posx="1800.5" posy="-1822.5" width="216" height="142" side="right" fold="false" treesize="142" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="Complete collection of instructions understood by the CPU (i.e. the **interface between software and hardware**)"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                    <node id="96" posx="1800.5" posy="-1680.5" width="179" height="47" side="right" fold="false" treesize="47" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="Usually proprietary"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                    <node id="21" posx="1800.5" posy="-1553" width="188" height="85" side="right" fold="false" treesize="246" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="**CISC**: Complext Instruction Set Computer (x86)"/>
                      </nodename>
                      <nodenote></nodenote>
                      <nodes>
                        <node id="23" posx="2088.5" posy="-1633.5" width="209" height="104" side="right" fold="false" treesize="104" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                          <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                          <nodename maxwidth="200">
                            <text data="Expose many complex instrucitons that get broken down internally into micro-operations"/>
                          </nodename>
                          <nodenote></nodenote>
                        </node>
                        <node id="24" posx="2088.5" posy="-1529.5" width="220" height="142" side="right" fold="false" treesize="142" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                          <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                          <nodename maxwidth="200">
                            <text data="Smaller code size, more expressive assembly at the cost of a more complicated core with fewer registers (direct memory operations)"/>
                          </nodename>
                          <nodenote></nodenote>
                        </node>
                      </nodes>
                    </node>
                    <node id="22" posx="1800.5" posy="-1274" width="208" height="104" side="right" fold="false" treesize="331" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
