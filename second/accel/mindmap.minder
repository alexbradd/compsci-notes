            <node id="138" posx="2944" posy="-3978.375" width="228" height="66" side="right" fold="false" treesize="170" color="#715344" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="Very integrated, but very expensive"/>
              </nodename>
              <nodenote></nodenote>
              <nodes>
                <node id="164" posx="3272" posy="-4030.375" width="213" height="66" side="right" fold="false" treesize="66" color="#715344" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="squared" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="**Very high NRE, but low cost per unit**"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
                <node id="166" posx="3272" posy="-3964.375" width="211" height="104" side="right" fold="false" treesize="104" color="#715344" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="Best used for high-performance designs where we plan to sell a lot of units"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
              </nodes>
            </node>
            <node id="140" posx="2944" posy="-3746.875" width="148" height="66" side="right" fold="false" treesize="293" color="#715344" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="**Full-custom designs**"/>
              </nodename>
              <nodenote></nodenote>
              <nodes>
                <node id="142" posx="3192" posy="-3860.375" width="197" height="66" side="right" fold="false" treesize="66" color="#715344" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="Highest performance and smallest die size"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
                <node id="143" posx="3192" posy="-3794.375" width="205" height="85" side="right" fold="false" treesize="85" color="#715344" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="Very complex, difficult and expensive to develop"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
                <node id="144" posx="3192" posy="-3709.375" width="219" height="142" side="right" fold="false" treesize="142" color="#715344" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="Microprocessors are the strandard example, but other examples are high-voltage systems, analog/digital, sensors, acturators and DRAM"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
              </nodes>
            </node>
            <node id="141" posx="2944" posy="-3458.375" width="138" height="66" side="right" fold="false" treesize="284" color="#715344" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="**Cell-based designs**"/>
              </nodename>
              <nodenote></nodenote>
              <nodes>
                <node id="145" posx="3182" posy="-3567.375" width="220" height="142" side="right" fold="false" treesize="142" color="#715344" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="Functions are built using a set of basic block and custom marcos (library) given by the manufacturer or developed in-house"/>
                  </nodename>
                  <nodenote></nodenote>
                  <nodes>
                    <node id="146" posx="3502" posy="-3529.375" width="195" height="66" side="right" fold="false" treesize="66" color="#715344" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="Cutom blocks can be embedded"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                  </nodes>
                </node>
                <node id="147" posx="3182" posy="-3425.375" width="219" height="142" side="right" fold="false" treesize="142" color="#715344" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="Standard cells are organized in rows (all cells have the same height for easier wiring) na different metals are used for connection"/>
                  </nodename>
                  <nodenote></nodenote>
                  <nodes>
                    <node id="149" posx="3501" posy="-3387.375" width="197" height="66" side="right" fold="false" treesize="66" color="#715344" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="Wiring can become a complex process"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                  </nodes>
                </node>
              </nodes>
            </node>
            <node id="151" posx="2944" posy="-3141.375" width="167" height="47" side="right" fold="false" treesize="331" color="#715344" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="Gate-array based"/>
              </nodename>
              <nodenote></nodenote>
              <nodes>
                <node id="152" posx="3211" posy="-3283.375" width="221" height="104" side="right" fold="false" treesize="104" color="#715344" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="Transitor patterns are predefined on the wafer (smallest element is the base cell)"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
                <node id="153" posx="3211" posy="-3179.375" width="228" height="85" side="right" fold="false" treesize="85" color="#715344" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="Top-level interconnect between cellsc is defined by the designer"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
                <node id="154" posx="3211" posy="-3094.375" width="224" height="142" side="right" fold="false" treesize="142" color="#715344" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="Design is done connecting predesigned logic cells from a library, then avter validation the design is converted into a layout"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
              </nodes>
            </node>
          </nodes>
        </node>
        <node id="134" posx="2742" posy="-2550.375" width="108" height="47" side="right" fold="false" treesize="851" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
          <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="squared" nodewidth="600" nodeborderwidth="6" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
          <nodename maxwidth="600">
            <text data="**FPGA**"/>
          </nodename>
          <nodenote></nodenote>
          <nodes>
            <node id="136" posx="2950" posy="-2682.875" width="211" height="104" side="right" fold="false" treesize="643" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="An IC designed to be **configured by the user to emulate any digital circuit**"/>
              </nodename>
              <nodenote></nodenote>
              <nodes>
                <node id="155" posx="3261" posy="-2876.875" width="227" height="142" side="right" fold="false" treesize="293" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="Core is a regular array of programmable basic logic cells (CLBs) that can implement cominatorial or sequential logic"/>
                  </nodename>
                  <nodenote></nodenote>
                  <nodes>
                    <node id="159" posx="3588" posy="-2952.375" width="218" height="66" side="right" fold="false" treesize="66" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="Basically **LUT + FF + MUX**"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                    <node id="160" posx="3588" posy="-2886.375" width="217" height="142" side="right" fold="false" treesize="142" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="The configuration is the values inside the LUT, the MUX defines if the cells will use or not the FF (combinatorial vs sequential) "/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                    <node id="162" posx="3588" posy="-2744.375" width="209" height="85" side="right" fold="false" treesize="85" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="Placement of the CLBs depends on I/O constraints "/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                  </nodes>
                </node>
                <node id="156" posx="3261" posy="-2649.875" width="187" height="123" side="right" fold="false" treesize="142" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="CLBs are connected through a programmable interconnect (switchboxes) "/>
                  </nodename>
                  <nodenote></nodenote>
                  <nodes>
                    <node id="163" posx="3548" posy="-2659.375" width="216" height="142" side="right" fold="false" treesize="142" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="After CLBs have been placed, routing is configured by configuring the vaious switchboxes and output cells"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                  </nodes>
                </node>
                <node id="158" posx="3261" posy="-2517.375" width="214" height="66" side="right" fold="false" treesize="66" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="Programmable I/O cells surround the core"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
                <node id="157" posx="3261" posy="-2451.375" width="227" height="142" side="right" fold="false" treesize="142" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="None of the masks are modified, instead we have a method for flashing our configuration (bitstream) onto the FPGA"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
              </nodes>
            </node>
            <node id="139" posx="2950" posy="-2228.875" width="208" height="47" side="right" fold="false" treesize="208" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="Cheaper to implement"/>
              </nodename>
              <nodenote></nodenote>
              <nodes>
                <node id="165" posx="3258" posy="-2309.375" width="218" height="104" side="right" fold="false" treesize="104" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="squared" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="**Almost zero NRE, but cost scales badly with the number of units**"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
                <node id="167" posx="3258" posy="-2205.375" width="221" height="104" side="right" fold="false" treesize="104" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="Best suited for special-purpose chips where we plan to sell a limited number of units"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
              </nodes>
            </node>
          </nodes>
        </node>
      </nodes>
    </node>
    <node id="173" posx="-1163.7581453634084" posy="2828.66259398496" width="581" height="85" side="left" fold="false" treesize="538.5" summarized="false" layout="Horizontal" group="false">
      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="600" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 36" nodemarkup="true"/>
      <nodename maxwidth="600">
        <text data="**HW/SW codesign**"/>
      </nodename>
      <nodenote></nodenote>
      <nodes>
        <node id="279" posx="-482.7581453634084" posy="2597.16259398496" width="221" height="85" side="right" fold="false" treesize="85" color="#f9c440" colorroot="false" summarized="false" layout="Horizontal" group="false">
          <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
          <nodename maxwidth="200">
            <text data="Implementing the entire application in hardware is rarely advantageous"/>
          </nodename>
          <nodenote></nodenote>
        </node>
        <node id="824" posx="-482.7581453634084" posy="2833.16259398496" width="211" height="161" side="right" fold="false" treesize="463" color="#c6262e" colorroot="false" summarized="false" layout="Horizontal" group="false">
          <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
          <nodename maxwidth="200">
            <text data="We **develop the application in a unified way**, then partion it between software and hardware based on the requirements"/>
          </nodename>
          <nodenote></nodenote>
          <nodes>
            <node id="280" posx="-171.7581453634084" posy="2682.16259398496" width="206" height="85" side="right" fold="false" treesize="85" color="#c6262e" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="The designer needs to integrate the software and hardware"/>
              </nodename>
              <nodenote></nodenote>
            </node>
            <node id="281" posx="-171.7581453634084" posy="2819.16259398496" width="214" height="104" side="right" fold="false" treesize="208" color="#c6262e" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="**Partition**: split the behaviour in chunks to be executed in possibly parallel"/>
              </nodename>
              <nodenote></nodenote>
              <nodes>
                <node id="284" posx="142.2418546365916" posy="2767.16259398496" width="226" height="85" side="right" fold="false" treesize="85" color="#c6262e" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="Can start by writing all in SW and then moving slow parts to hardware"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
                <node id="285" posx="142.2418546365916" posy="2852.16259398496" width="212" height="123" side="right" fold="false" treesize="123" color="#c6262e" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="Can start by making everything in hardware and then moving expensive bits to software"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
              </nodes>
            </node>
            <node id="282" posx="-171.7581453634084" posy="2975.1625939849605" width="201" height="85" side="right" fold="false" treesize="85" color="#c6262e" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="**Map**: assign the tasks to the hardware components"/>
              </nodename>
              <nodenote></nodenote>
            </node>
            <node id="283" posx="-171.7581453634084" posy="3060.1625939849605" width="208" height="85" side="right" fold="false" treesize="85" color="#c6262e" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
