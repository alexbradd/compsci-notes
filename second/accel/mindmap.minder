    </node>
    <node id="178" posx="-921.00000000000182" posy="3748.9583333333362" width="831" height="85" side="left" fold="false" treesize="1013" summarized="false" layout="Horizontal" group="false">
      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="900" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 36" nodemarkup="true"/>
      <nodename maxwidth="900">
        <text data="**Latency-insenstive design**"/>
      </nodename>
      <nodenote></nodenote>
      <nodes>
        <node id="253" posx="-1245.0000000000018" posy="3569.4583333333362" width="224" height="66" side="left" fold="false" treesize="501" color="#7a36b1" colorroot="false" summarized="false" layout="Horizontal" group="false">
          <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
          <nodename maxwidth="200">
            <text data="**Delays** on wires can cause problems"/>
          </nodename>
          <nodenote></nodenote>
          <nodes>
            <node id="254" posx="-1527.0000000000018" posy="3351.9583333333362" width="182" height="104" side="left" fold="false" treesize="104" color="#7a36b1" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="In deep sub-micron processes, **variability** is a concern"/>
              </nodename>
              <nodenote></nodenote>
            </node>
            <node id="255" posx="-1573.0000000000018" posy="3455.9583333333362" width="228" height="85" side="left" fold="false" treesize="85" color="#7a36b1" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="Transistors shrink but not the wires: **wire delay dominates**"/>
              </nodename>
              <nodenote></nodenote>
            </node>
            <node id="256" posx="-1570.0000000000018" posy="3540.9583333333362" width="225" height="123" side="left" fold="false" treesize="123" color="#7a36b1" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="We cannot eliminate long wires, thus we need a **protocol that is insensitive to delays**"/>
              </nodename>
              <nodenote></nodenote>
            </node>
            <node id="259" posx="-1567.0000000000018" posy="3663.9583333333362" width="222" height="85" side="left" fold="false" treesize="85" color="#7a36b1" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="**Not every delay can be accounted for at design time**"/>
              </nodename>
              <nodenote></nodenote>
            </node>
            <node id="258" posx="-1569.0000000000018" posy="3748.9583333333362" width="224" height="104" side="left" fold="false" treesize="104" color="#7a36b1" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="Thus, **timing of the components becomes a non-functional requirement**"/>
              </nodename>
              <nodenote></nodenote>
            </node>
          </nodes>
        </node>
        <node id="261" posx="-1231.0000000000018" posy="4008.9583333333362" width="210" height="66" side="left" fold="false" treesize="378" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
          <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
          <nodename maxwidth="200">
            <text data="Latency-insensitive protocol works as such"/>
          </nodename>
          <nodenote></nodenote>
          <nodes>
            <node id="262" posx="-1548.0000000000018" posy="3876.4583333333362" width="217" height="104" side="left" fold="false" treesize="151" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="At each clock cycle, the **sources sends packets** with two singals"/>
              </nodename>
              <nodenote></nodenote>
              <nodes>
                <node id="263" posx="-1865.0000000000018" posy="3852.9583333333362" width="217" height="47" side="left" fold="false" treesize="47" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="**data** is the payload"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
                <node id="265" posx="-1867.0000000000018" posy="3909.4583333333362" width="219" height="85" side="left" fold="false" treesize="104" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="**void** indicates if the current data is valid or not"/>
                  </nodename>
                  <nodenote></nodenote>
                  <nodes>
                    <node id="266" posx="-2195.0000000000018" posy="3899.9583333333362" width="228" height="104" side="left" fold="false" treesize="104" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="if `void = 1` the data is not informative and it is considered a stalling event"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                  </nodes>
                </node>
              </nodes>
            </node>
            <node id="267" posx="-1545.0000000000018" posy="4003.9583333333362" width="214" height="104" side="left" fold="false" treesize="104" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="**Sinks send back a `stop` singal** if they cannot process any more data"/>
              </nodename>
              <nodenote></nodenote>
            </node>
            <node id="276" posx="-1524.0000000000018" posy="4107.9583333333358" width="193" height="123" side="left" fold="false" treesize="123" color="#333333" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="The **consecutive connection** of the control singal **provides backpressure**"/>
              </nodename>
              <nodenote></nodenote>
            </node>
          </nodes>
        </node>
        <node id="268" posx="9.999999999998181" posy="3497.9583333333362" width="181" height="104" side="right" fold="false" treesize="530" color="#c6262e" colorroot="false" summarized="false" layout="Horizontal" group="false">
          <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
          <nodename maxwidth="200">
            <text data="The protocol is implemented using **two main components**"/>
          </nodename>
          <nodenote></nodenote>
          <nodes>
            <node id="269" posx="290.99999999999818" posy="3332.4583333333362" width="188" height="47" side="right" fold="false" treesize="142" color="#c6262e" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="**Relay stations**"/>
              </nodename>
              <nodenote></nodenote>
              <nodes>
                <node id="270" posx="578.99999999999818" posy="3284.9583333333362" width="223" height="142" side="right" fold="false" treesize="142" color="#c6262e" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="They are placed along long wires and introduce 1 clock cycle of latency, propagating eventual `void` and `stop` signals"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
              </nodes>
            </node>
            <node id="271" posx="290.99999999999818" posy="3597.4583333333362" width="114" height="47" side="right" fold="false" treesize="388" color="#c6262e" colorroot="false" summarized="false" layout="Horizontal" group="false">
              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
              <nodename maxwidth="200">
                <text data="**Shells**"/>
              </nodename>
              <nodenote></nodenote>
              <nodes>
                <node id="272" posx="504.99999999999818" posy="3426.9583333333362" width="224" height="180" side="right" fold="false" treesize="180" color="#c6262e" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="They **wrap components** that have not been designed for latency-insensitivity providing it transparently, as long as the component is stallable"/>
                  </nodename>
                  <nodenote></nodenote>
                </node>
                <node id="273" posx="504.99999999999818" posy="3606.9583333333362" width="196" height="104" side="right" fold="false" treesize="104" color="#c6262e" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="**Incoming data, if informative, is queued** in a FIFO queue"/>
                  </nodename>
                  <nodenote></nodenote>
                  <nodes>
                    <node id="274" posx="800.99999999999818" posy="3625.9583333333362" width="207" height="66" side="right" fold="false" treesize="66" color="#c6262e" colorroot="false" summarized="false" layout="Horizontal" group="false">
                      <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                      <nodename maxwidth="200">
                        <text data="When the **queue is full, `stop` is sent**"/>
                      </nodename>
                      <nodenote></nodenote>
                    </node>
                  </nodes>
                </node>
                <node id="275" posx="504.99999999999818" posy="3710.9583333333362" width="226" height="104" side="right" fold="false" treesize="104" color="#c6262e" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="The **component is stalled if the next component's `stop` is raised**"/>
