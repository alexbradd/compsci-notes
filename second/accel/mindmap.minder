                      <nodename maxwidth="200">
                        <text data="**RISC**: Reduced Instruction Set Computer (ARM, RISC-V...)"/>
                      </nodename>
                      <nodenote></nodenote>
                      <nodes>
                        <node id="25" posx="2108.5" posy="-1387.5" width="189" height="66" side="right" fold="false" treesize="66" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                          <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                          <nodename maxwidth="200">
                            <text data="Expose less, simpler instructions"/>
                          </nodename>
                          <nodenote></nodenote>
                        </node>
                        <node id="26" posx="2108.5" posy="-1321.5" width="217" height="123" side="right" fold="false" treesize="123" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                          <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                          <nodename maxwidth="200">
                            <text data="Larger code size, more difficult to write assembly but with simpler cores and more registers"/>
                          </nodename>
                          <nodenote></nodenote>
                        </node>
                        <node id="100" posx="2108.5" posy="-1198.5" width="217" height="142" side="right" fold="false" treesize="142" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                          <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                          <nodename maxwidth="200">
                            <text data="**RISC-V is open source** and allows easy implementation of **ISA extension** for custom application needs"/>
                          </nodename>
                          <nodenote></nodenote>
                        </node>
                      </nodes>
                    </node>
                  </nodes>
                </node>
              </nodes>
            </node>
