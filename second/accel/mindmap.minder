                              <nodename maxwidth="200">
                                <text data="**Do not add too much congestion** to the shared bus"/>
                              </nodename>
                              <nodenote></nodenote>
                            </node>
                            <node id="113" posx="2408.5" posy="407.5" width="217" height="104" side="right" fold="false" treesize="104" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                              <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                              <nodename maxwidth="200">
                                <text data="**Exploit the congestion** to optimize overall system latency"/>
                              </nodename>
                              <nodenote></nodenote>
                            </node>
                          </nodes>
                        </node>
                        <node id="182" posx="2086.5" posy="620" width="206" height="104" side="right" fold="false" treesize="321" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
