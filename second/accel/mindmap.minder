                      </nodes>
                    </node>
                  </nodes>
                </node>
                <node id="19" posx="1480.5" posy="-1529.5" width="219" height="85" side="right" fold="false" treesize="766" color="#68b723" colorroot="false" summarized="false" layout="Horizontal" group="false">
                  <style branchmargin="100" branchradius="25" linktype="curved" linkwidth="4" linkarrow="false" linkdash="solid" nodeborder="underlined" nodewidth="200" nodeborderwidth="4" nodefill="false" nodemargin="8" nodepadding="6" nodefont="Sans 12" nodemarkup="true"/>
                  <nodename maxwidth="200">
                    <text data="They execute instructions defined in a **ISA**"/>
                  </nodename>
                  <nodenote></nodenote>
                  <callout>
                    <text maxwidth="200">
                      <text data="For more, yap about what you learned during ACA"/>
